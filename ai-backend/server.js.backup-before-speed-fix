app.use(
    (
        error,
        req,
        res,
        next
    ) => {

        console.error(
            "SERVER ERROR:",
            error
        );


        if (
            error instanceof
            multer.MulterError
        ) {

            return res.status(
                400
            ).json({

                success:
                    false,

                error:
                    error.message
            });
        }


        return res.status(
            500
        ).json({

            success:
                false,

            error:
                error.message ||
                "Server error."
        });
    }
);


