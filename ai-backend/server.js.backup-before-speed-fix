/* =========================================================
   AI MOVEMENT COACH — GEMINI BACKEND
========================================================= */

require("dotenv").config();

const express = require("express");
const multer = require("multer");
const path = require("path");
const fs = require("fs");
const https = require("https");
const http = require("http");
const { execFile } = require("child_process");

const { GoogleGenAI } = require("@google/genai");


/* =========================================================
   CONFIG
========================================================= */

const app = express();

const PORT =
    process.env.PORT || 5000;

const GEMINI_API_KEY =
    process.env.GEMINI_API_KEY;

// Gemini model can be changed from Render Environment Variables.
const GEMINI_MODEL =
    process.env.GEMINI_MODEL ||
    "gemini-3.6-flash";


if (!GEMINI_API_KEY) {

    console.error("");
    console.error("ERROR: GEMINI_API_KEY is missing.");
    console.error("Check Render Environment Variables.");
    console.error("");
}


const ai =
    new GoogleGenAI({
        apiKey: GEMINI_API_KEY
    });


/* =========================================================
   UPLOAD DIRECTORY
========================================================= */

const uploadDir =
    path.join(
        __dirname,
        "uploads"
    );


if (!fs.existsSync(uploadDir)) {

    fs.mkdirSync(
        uploadDir,
        {
            recursive: true
        }
    );
}


/* =========================================================
   MULTER STORAGE
========================================================= */

const storage =
    multer.diskStorage({

        destination:
            (req, file, cb) => {

                cb(
                    null,
                    uploadDir
                );
            },

        filename:
            (req, file, cb) => {

                const extension =
                    path.extname(
                        file.originalname
                    ) || ".webm";


                const filename =
                    `${Date.now()}-${Math.random().toString(36).slice(2)}${extension}`;


                cb(
                    null,
                    filename
                );
            }
    });


const upload =
    multer({

        storage,

        limits: {

            fileSize:
                500 * 1024 * 1024
        },

        fileFilter:
            (req, file, cb) => {

                console.log("");
                console.log("========================================");
                console.log("UPLOAD FILE");
                console.log("========================================");

                console.log(
                    "Name:",
                    file.originalname
                );

                console.log(
                    "MIME:",
                    file.mimetype
                );

                console.log("========================================");
                console.log("");


                const mimeType =
                    String(
                        file.mimetype || ""
                    ).toLowerCase();


                const extension =
                    path.extname(
                        file.originalname || ""
                    ).toLowerCase();


                const allowedExtensions = [

                    ".mp4",
                    ".webm",
                    ".mov",
                    ".avi",
                    ".mpeg",
                    ".mpg",
                    ".ogg",
                    ".mkv"
                ];


                const isVideo =
                    mimeType.startsWith(
                        "video/"
                    ) ||
                    allowedExtensions.includes(
                        extension
                    );


                if (isVideo) {

                    cb(
                        null,
                        true
                    );

                } else {

                    cb(
                        new Error(
                            `Only video files are allowed. Received MIME: ${mimeType}, Extension: ${extension}`
                        )
                    );
                }
            }
    });


/* =========================================================
   VALIDATION ALLOW-LISTS
========================================================= */

const ALLOWED_MODES = [

    "dance",
    "gym",
    "yoga",
    "fitness",
    "exercise",
    "wellness"
];


const ALLOWED_EXERCISES = [

    "dance",
    "squat",
    "pushup",
    "lunge",
    "bicepcurl",
    "shoulderpress",
    "standing",
    "gym",
    "yoga",
    "fitness",
    "exercise",
    "wellness"
];


const ALLOWED_LANGUAGES = [

    "en-IN",
    "te-IN",
    "hi-IN"
];


const ALLOWED_GOALS = [

    "general",
    "strength",
    "flexibility",
    "weight",
    "activity"
];


const ALLOWED_LEVELS = [

    "beginner",
    "intermediate",
    "advanced"
];


function sanitizeChoice(
    value,
    allowed,
    fallback
) {

    const str =
        String(
            value || ""
        ).trim();


    return allowed.includes(str)
        ? str
        : fallback;
}


/* =========================================================
   MIDDLEWARE
========================================================= */

app.use(
    express.json({
        limit: "10mb"
    })
);


app.use(
    express.urlencoded({
        extended: true,
        limit: "10mb"
    })
);


/* =========================================================
   CORS
========================================================= */

app.use(
    (req, res, next) => {

        res.header(
            "Access-Control-Allow-Origin",
            "*"
        );

        res.header(
            "Access-Control-Allow-Methods",
            "GET,POST,PUT,PATCH,DELETE,OPTIONS"
        );

        res.header(
            "Access-Control-Allow-Headers",
            "Origin, X-Requested-With, Content-Type, Accept, Authorization"
        );


        if (
            req.method === "OPTIONS"
        ) {

            return res.sendStatus(
                204
            );
        }


        next();
    }
);


/* =========================================================
   API-ONLY ROOT
========================================================= */

/*
   The frontend is hosted separately on Vercel.

   This Render service is only responsible for
   backend/API requests.
*/

app.get(
    "/",
    (req, res) => {

        res.json({

            success:
                true,

            message:
                "AI Movement Coach Backend is running.",

            frontend:
                "Frontend is hosted separately.",

            health:
                "/api/health",

            endpoints: [

                "/api/health",
                "/api/analyze",
                "/api/fitness-plan",
                "/api/coach-recommendation",
                "/api/chat"
            ]
        });
    }
);


/* =========================================================
   HEALTH CHECK
========================================================= */

app.get(
    "/api/health",
    (req, res) => {

        res.json({

            success:
                true,

            message:
                GEMINI_API_KEY
                    ? "AI Movement Coach Backend is running"
                    : "Backend running, but GEMINI_API_KEY is missing",

            ai:
                "Gemini",

            model:
                GEMINI_MODEL,

            features: [

                "video-analysis",

                "auto-exercise-recognition (client-side)",

                "rep-counting (client-side)",

                "coach-recommendation",

                "multilingual-chat",

                "correction-guidance"
            ]
        });
    }
);


/* =========================================================
   ANALYZE VIDEO
========================================================= */

app.post(
    "/api/analyze",

    upload.fields([

        {
            name: "video",
            maxCount: 1
        },

        {
            name: "reference",
            maxCount: 1
        }
    ]),

    async (req, res) => {

        let practicePath =
            null;

        let referencePath =
            null;

        let practiceGeminiPath =
            null;

        let referenceGeminiPath =
            null;


        try {

            /* =====================================================
               API KEY CHECK
            ===================================================== */

            if (!GEMINI_API_KEY) {

                return res.status(
                    500
                ).json({

                    success:
                        false,

                    error:
                        "GEMINI_API_KEY is not configured."
                });
            }


            /* =====================================================
               GET UPLOADED FILES
            ===================================================== */

            const practiceFile =
                req.files?.video?.[0];


            let referenceFile =
                req.files?.reference?.[0];


            if (!practiceFile) {

                return res.status(
                    400
                ).json({

                    success:
                        false,

                    error:
                        "Practice video is required."
                });
            }


            practicePath =
                practiceFile.path;


            if (referenceFile) {

                referencePath =
                    referenceFile.path;
            }


            /* =====================================================
               DIRECT REFERENCE VIDEO URL
            ===================================================== */

            const referenceUrl =
                typeof req.body.referenceUrl === "string"
                    ? req.body.referenceUrl.trim()
                    : "";


            if (
                !referenceFile &&
                referenceUrl
            ) {

                console.log(
                    "Fetching reference video from URL:",
                    referenceUrl
                );


                try {

                    const fetched =
                        await fetchRemoteVideoToTemp(
                            referenceUrl,
                            uploadDir
                        );


                    referencePath =
                        fetched.path;


                    referenceFile = {

                        originalname:
                            fetched.filename,

                        mimetype:
                            fetched.mimeType
                    };


                    console.log(
                        "Reference fetched from URL:",
                        fetched.filename,
                        fetched.mimeType
                    );

                } catch (fetchError) {

                    console.warn(
                        "Reference URL fetch failed:",
                        fetchError.message
                    );

                    /*
                       Non-fatal.

                       Analysis continues without
                       the reference video.
                    */
                }
            }


            /* =====================================================
               SAFE MODE / EXERCISE / LANGUAGE
            ===================================================== */

            const mode =
                sanitizeChoice(
                    req.body.mode,
                    ALLOWED_MODES,
                    "exercise"
                );


            const exercise =
                sanitizeChoice(
                    req.body.exercise,
                    ALLOWED_EXERCISES,
                    mode
                );


            const language =
                sanitizeChoice(
                    req.body.language,
                    ALLOWED_LANGUAGES,
                    "en-IN"
                );


            /* =====================================================
               ON-DEVICE SESSION METRICS
            ===================================================== */

            const sessionMetrics = {

                reps:
                    safeIntInRange(
                        req.body.reps,
                        0,
                        500
                    ),

                correctReps:
                    safeIntInRange(
                        req.body.correctReps,
                        0,
                        500
                    ),

                corrections:
                    safeIntInRange(
                        req.body.corrections,
                        0,
                        500
                    ),

                liveFormScore:
                    safeIntInRange(
                        req.body.liveFormScore,
                        0,
                        100
                    ),

                recognitionConfidence:
                    safeIntInRange(
                        req.body.recognitionConfidence,
                        0,
                        100
                    ),

                duration:
                    safeIntInRange(
                        req.body.duration,
                        0,
                        3600
                    ),

                jointMetrics:
                    safeParseJointMetrics(
                        req.body.jointMetrics
                    )
            };


            /* =====================================================
               LOG SESSION
            ===================================================== */

            console.log("");
            console.log("========================================");
            console.log("AI ANALYSIS STARTED");
            console.log("========================================");

            console.log(
                "Mode:",
                mode
            );

            console.log(
                "Exercise:",
                exercise
            );

            console.log(
                "Primary language:",
                language
            );

            console.log(
                "Session metrics:",
                sessionMetrics
            );

            console.log(
                "Practice:",
                practiceFile.originalname
            );

            console.log(
                "Practice MIME:",
                practiceFile.mimetype
            );

            console.log(
                "Reference:",
                referenceFile
                    ? referenceFile.originalname
                    : "None"
            );

            console.log("");


            /* =====================================================
   UPLOAD PRACTICE VIDEO DIRECTLY TO GEMINI
   SPEED OPTIMIZATION:
   Browser WebM is sent directly to Gemini.
   No FFmpeg conversion for the practice video.
===================================================== */

console.log(
    "Preparing practice video for Gemini..."
);

const practiceMimeType =
    String(
        practiceFile.mimetype ||
        "video/webm"
    ).toLowerCase();


console.log(
    "Practice video:",
    practicePath
);

console.log(
    "Practice MIME:",
    practiceMimeType
);


/* =====================================================
   UPLOAD PRACTICE VIDEO TO GEMINI
===================================================== */

console.log(
    "Uploading practice video directly to Gemini..."
);


let practiceGeminiFile =
    await ai.files.upload({

        file:
            practicePath,

        config: {

            mimeType:
                practiceMimeType
        }
    });


console.log(
    "Practice uploaded:",
    practiceGeminiFile.name
);


practiceGeminiFile =
    await waitForFileReady(
        practiceGeminiFile.name
    );


console.log(
    "Practice video ready."
);


            /* =====================================================
               REFERENCE VIDEO
            ===================================================== */

            let referenceGeminiFile =
                null;


            if (referencePath) {

                console.log(
                    "Preparing reference video for Gemini..."
                );


                referenceGeminiPath =
                    await convertVideoToMp4(
                        referencePath
                    );


                console.log(
                    "Reference converted to MP4:",
                    referenceGeminiPath
                );


                console.log(
                    "Uploading converted reference video to Gemini..."
                );


                referenceGeminiFile =
                    await ai.files.upload({

                        file:
                            referenceGeminiPath,

                        config: {

                            mimeType:
                                "video/mp4"
                        }
                    });


                console.log(
                    "Reference uploaded:",
                    referenceGeminiFile.name
                );


                referenceGeminiFile =
                    await waitForFileReady(
                        referenceGeminiFile.name
                    );


                console.log(
                    "Reference video ready."
                );
            }


            /* =====================================================
               BUILD GEMINI PROMPT
            ===================================================== */

            const prompt =
                buildAnalysisPrompt({

                    mode,

                    exercise,

                    language,

                    hasReference:
                        Boolean(
                            referenceGeminiFile
                        ),

                    sessionMetrics
                });


            /* =====================================================
               GEMINI CONTENT PARTS
            ===================================================== */

            const contentParts = [

                {
                    text:
                        prompt
                }
            ];


            if (referenceGeminiFile) {

                contentParts.push({

                    fileData: {

                        fileUri:
                            referenceGeminiFile.uri,

                        mimeType:
                            referenceGeminiFile.mimeType
                    }
                });
            }


            contentParts.push({

                fileData: {

                    fileUri:
                        practiceGeminiFile.uri,

                    mimeType:
                        practiceGeminiFile.mimeType
                }
            });


            /* =====================================================
               GEMINI VIDEO ANALYSIS
               RETRY + FALLBACK MODELS
            ===================================================== */

            let response =
                null;

            let lastGeminiError =
                null;


            const analysisModels = [

                GEMINI_MODEL,

                "gemini-3.6-flash",

                "gemini-3.1-flash-lite"
            ];


            for (
                const model
                of [...new Set(analysisModels)]
            ) {

                for (
                    let attempt = 1;
                    attempt <= 2;
                    attempt++
                ) {

                    try {

                        console.log("");

                        console.log(
                            `Gemini video analysis: model=${model}, attempt=${attempt}`
                        );


                        response =
                            await ai.models.generateContent({

                                model:

                                    model,

                                contents: [

                                    {
                                        role:
                                            "user",

                                        parts:
                                            contentParts
                                    }
                                ],

                                config: {

                                    responseMimeType:
                                        "application/json"
                                }
                            });


                        if (response) {

                            console.log(
                                `Gemini video analysis success: model=${model}, attempt=${attempt}`
                            );

                            break;
                        }

                    } catch (error) {

                        lastGeminiError =
                            error;


                        const status =
                            error?.status ||
                            error?.code ||
                            error?.error?.code;


                        console.error(
                            `Gemini video analysis failed: model=${model}, attempt=${attempt}, status=${status}`
                        );


                        console.error(
                            error?.message ||
                            error
                        );


                        /*
                           503 means temporary
                           service/high-demand issue.

                           Retry the same model once.
                        */

                        if (
                            status === 503 &&
                            attempt < 2
                        ) {

                            const delay =
                                attempt * 5000;


                            console.log(
                                `Gemini returned 503. Retrying in ${delay / 1000} seconds...`
                            );


                            await sleep(
                                delay
                            );


                            continue;
                        }


                        /*
                           Other errors do not need
                           repeated attempts on the
                           same model.
                        */

                        break;
                    }
                }


                if (response) {

                    break;
                }


                console.warn(
                    `Gemini model ${model} could not complete video analysis. Trying fallback model...`
                );
            }


            if (!response) {

                throw (
                    lastGeminiError ||
                    new Error(
                        "Gemini did not return a response."
                    )
                );
            }


            /* =====================================================
               GEMINI RESPONSE
            ===================================================== */

            const rawText =
                extractText(
                    response
                );


            console.log("");

            console.log(
                "Gemini response received."
            );

            console.log(
                rawText
            );


            /* =====================================================
               PARSE + NORMALIZE
            ===================================================== */

            const result =
                parseGeminiJSON(
                    rawText
                );


            const cleaned =
                normalizeServerResult(
                    result
                );


            console.log("");

            console.log(
                "========================================"
            );

            console.log(
                "AI ANALYSIS COMPLETE"
            );

            console.log(
                "========================================"
            );

            console.log(
                "Score:",
                cleaned.score
            );

            console.log(
                "Mistakes:",
                cleaned.mistakes.length
            );

            console.log("");


            return res.json({

                success:
                    true,

                ...cleaned
            });


        } catch (error) {

            console.error("");
            console.error("========================================");
            console.error("AI ANALYSIS ERROR");
            console.error("========================================");

            console.error(
                error
            );

            console.error("");

            console.error(
                "REAL GEMINI ERROR MESSAGE:",
                error?.message
            );

            console.error(
                "REAL GEMINI ERROR STACK:",
                error?.stack
            );


            const classified =
                classifyGeminiError(
                    error
                );


            return res.status(
                classified.status
            ).json({

                success:
                    false,

                error:
                    classified.error
            });


        } finally {

            /* =====================================================
               CLEAN TEMPORARY FILES
            ===================================================== */

            cleanupFile(
                practicePath
            );

            cleanupFile(
                referencePath
            );

            cleanupFile(
                practiceGeminiPath
            );

            cleanupFile(
                referenceGeminiPath
            );
        }
    }
);


/* =========================================================
   PERSONALIZED FITNESS PLAN
========================================================= */

app.post(
    "/api/fitness-plan",

    async (req, res) => {

        try {

            if (!GEMINI_API_KEY) {

                return res.status(
                    500
                ).json({

                    success:
                        false,

                    error:
                        "GEMINI_API_KEY is not configured."
                });
            }


            const safeGoal =
                sanitizeChoice(
                    req.body?.goal,
                    ALLOWED_GOALS,
                    "general"
                );


            const safeLevel =
                sanitizeChoice(
                    req.body?.level,
                    ALLOWED_LEVELS,
                    "beginner"
                );


            const safeMode =
                sanitizeChoice(
                    req.body?.mode,
                    ALLOWED_MODES,
                    "exercise"
                );


            const safeLanguage =
                sanitizeChoice(
                    req.body?.language,
                    ALLOWED_LANGUAGES,
                    "en-IN"
                );


            console.log("");

            console.log(
                "Fitness plan requested:",
                {

                    goal:
                        safeGoal,

                    level:
                        safeLevel,

                    mode:
                        safeMode,

                    language:
                        safeLanguage
                }
            );


            const prompt =
                buildFitnessPlanPrompt({

                    goal:
                        safeGoal,

                    level:
                        safeLevel,

                    mode:
                        safeMode,

                    language:
                        safeLanguage
                });


            /* =====================================================
               FITNESS PLAN GEMINI REQUEST
            ===================================================== */

            let response =
                null;

            let lastGeminiError =
                null;


            const fitnessModels = [

                GEMINI_MODEL,

                "gemini-3.6-flash",

                "gemini-3.1-flash-lite"
            ];


            for (
                const model
                of [...new Set(fitnessModels)]
            ) {

                for (
                    let attempt = 1;
                    attempt <= 2;
                    attempt++
                ) {

                    try {

                        console.log(
                            `Fitness plan Gemini request: model=${model}, attempt=${attempt}`
                        );


                        response =
                            await ai.models.generateContent({

                                model:

                                    model,

                                contents: [

                                    {
                                        role:
                                            "user",

                                        parts: [

                                            {
                                                text:
                                                    prompt
                                            }
                                        ]
                                    }
                                ],

                                config: {

                                    responseMimeType:
                                        "application/json"
                                }
                            });


                        if (response) {

                            break;
                        }

                    } catch (error) {

                        lastGeminiError =
                            error;


                        const status =
                            error?.status ||
                            error?.code ||
                            error?.error?.code;


                        console.error(
                            `Fitness plan Gemini failed: model=${model}, attempt=${attempt}, status=${status}`
                        );


                        console.error(
                            error?.message ||
                            error
                        );


                        if (
                            status === 503 &&
                            attempt < 2
                        ) {

                            await sleep(
                                attempt * 3000
                            );

                            continue;
                        }


                        break;
                    }
                }


                if (response) {
                    break;
                }
            }


            if (!response) {

                throw (
                    lastGeminiError ||
                    new Error(
                        "Gemini did not return a response."
                    )
                );
            }


            const result =
                parseGeminiJSON(
                    extractText(
                        response
                    )
                );


            const cleaned =
                normalizeFitnessPlan(
                    result
                );


            return res.json({

                success:
                    true,

                ...cleaned
            });


        } catch (error) {

            console.error(
                "Fitness plan error:",
                error
            );


            const classified =
                classifyGeminiError(
                    error
                );


            return res.status(
                classified.status
            ).json({

                success:
                    false,

                error:
                    classified.error
            });
        }
    }
);


/* =========================================================
   ADAPTIVE AI COACH RECOMMENDATION
========================================================= */

app.post(
    "/api/coach-recommendation",

    async (req, res) => {

        try {

            if (!GEMINI_API_KEY) {

                return res.status(
                    500
                ).json({

                    success:
                        false,

                    error:
                        "GEMINI_API_KEY is not configured."
                });
            }


            const {
                exercise,
                current,
                previous
            } = req.body || {};


            const language =
                sanitizeChoice(
                    req.body?.language,
                    ALLOWED_LANGUAGES,
                    "en-IN"
                );


            if (
                !current ||
                typeof current !== "object"
            ) {

                return res.status(
                    400
                ).json({

                    success:
                        false,

                    error:
                        "current session metrics are required."
                });
            }


            const safeExercise =
                String(
                    exercise ||
                    "general movement"
                ).slice(
                    0,
                    60
                );


            const languageName =
                languageDisplayName(
                    language
                );


            const safeCurrent = {

                score:
                    safeNumber(
                        current.score
                    ),

                reps:
                    safeNumber(
                        current.reps
                    ),

                correctReps:
                    safeNumber(
                        current.correctReps
                    ),

                corrections:
                    safeNumber(
                        current.corrections
                    ),

                duration:
                    safeNumber(
                        current.duration
                    )
            };


            const safePrevious =
                previous &&
                typeof previous === "object"

                    ? {

                        score:
                            safeNumber(
                                previous.score
                            ),

                        reps:
                            safeNumber(
                                previous.reps
                            ),

                        correctReps:
                            safeNumber(
                                previous.correctReps
                            ),

                        corrections:
                            safeNumber(
                                previous.corrections
                            )
                    }

                    : null;


            const prompt = `
You are a personalized AI fitness coach inside a movement-training app.

Exercise: ${safeExercise}
Write your reply in: ${languageName}

CURRENT SESSION:
- Overall AI score: ${safeCurrent.score ?? "unknown"}%
- Reps completed: ${safeCurrent.reps ?? 0}
- Reps with good form: ${safeCurrent.correctReps ?? 0}
- Form corrections needed: ${safeCurrent.corrections ?? 0}
- Session duration (seconds): ${safeCurrent.duration ?? "unknown"}

PREVIOUS SESSION FOR THE SAME EXERCISE:
${
    safePrevious
        ? `
- Overall AI score: ${safePrevious.score ?? "unknown"}%
- Reps completed: ${safePrevious.reps ?? 0}
- Reps with good form: ${safePrevious.correctReps ?? 0}
- Form corrections needed: ${safePrevious.corrections ?? 0}
`
        : "No previous session for this exercise yet."
}

